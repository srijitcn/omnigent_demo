# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# Omnigent local state / logs (if any land in the app dir)
.omnigent/

# Runtime ontology context — ontogent rewrites it every run. The repo ships
# ontology_context.md.template; the live file is seeded from it and not tracked.
ontology_context.md

# Generated output — every project/asset ontogent builds lives under output/
# (gitignored, so the repo stays just the orchestrator). The folder itself is
# kept via .gitkeep so it exists in a fresh clone.
output/*
!output/.gitkeep

# Legacy ad-hoc output folders from earlier runs (superseded by output/).
demo1/
books_app/
